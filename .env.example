# Node Environment
NODE_ENV=development
PORT=3000

# Database (Neon PostgreSQL Frankfurt)
DATABASE_URL=postgresql://user:password@ep-sample-123456.eu-central-1.aws.neon.tech/health_dashboard?sslmode=require

# Authentication & Encryption
JWT_SECRET=replace-with-at-least-32-chars-secret-jwt-token
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Scheduling & Webhooks Secrets
CRON_SECRET=replace-with-secret-min-16-chars-for-github-cron
WEBHOOK_AUTH_TOKEN=replace-with-secret-min-16-chars-for-google-webhooks

# Google OAuth & Health API (Project Scoped)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connect/google/callback
GOOGLE_PROJECT_ID=1041840627764 # Google Cloud Project Number (numeric, e.g. 1041840627764, recommended by Google Health API)
GOOGLE_SUBSCRIBER_ID=health-dashboard-sub
APP_BASE_URL=https://health-dashboard-85m6.onrender.com
